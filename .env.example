# ================== IA (cascade : DeepSeek -> Kimi -> Claude) ==================
# Ordre de priorite (optionnel ; defaut ci-dessous)
AI_PROVIDER_ORDER=deepseek,kimi,claude

# 1) DeepSeek (prioritaire) — API compatible OpenAI
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 2) Kimi / Moonshot — API compatible OpenAI
KIMI_API_KEY=sk-...
KIMI_MODEL=kimi-k2-0711-preview
# KIMI_BASE_URL=https://api.moonshot.ai/v1     # (.cn pour la Chine continentale)

# 3) Claude / Anthropic (dernier repli)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# ================== Canaux d'envoi ==================
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.email@gmail.com
SMTP_PASSWORD=mot_de_passe_application
EMAIL_TO=destinataire@example.com
